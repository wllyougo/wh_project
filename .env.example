# 이미지 식별: 사진을 잠깐 올려 둘 곳(Vercel Blob)과 이미지 검색(SerpApi)
# Vercel 프로젝트의 Storage에서 Blob 저장소를 만들어 연결하면 배포 환경에는 BLOB_STORE_ID가 자동으로 생긴다.
# 로컬에서는 읽기·쓰기 토큰이 필요하다 (Vercel 저장소 화면에서 발급).
BLOB_READ_WRITE_TOKEN=
SERPAPI_KEY=

# 원문 읽기: Anthropic 호환 API (사내 게이트웨이를 쓰면 주소도 넣는다)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
# 게이트웨이가 요구하는 헤더가 있으면 "이름: 값"으로 적는다 (여러 개는 \n으로 잇는다)
ANTHROPIC_CUSTOM_HEADERS=

# 선택: 외부 서비스 주소를 바꿔야 할 때만 (예: 로컬 시험용 가짜 서버)
# SERPAPI_BASE_URL=
